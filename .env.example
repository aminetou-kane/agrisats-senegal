# Copiez ce fichier en ".env" et remplissez les valeurs. Le fichier ".env" ne doit JAMAIS être publié.

SECRET_KEY=generez-une-longue-cle-avec-python-secrets
# En ligne (HTTPS) : mettre 1. Le cookie de connexion n'est alors envoyé que par HTTPS.
PRODUCTION=0
# 1 = comptes et machines de démonstration au premier démarrage, 0 = base vide
DONNEES_DEMO=1
# Adresse publique du site (sert au retour après paiement)
SITE_URL=http://127.0.0.1:5000

# --- Paiement Bitcoin Lightning via BTCPay Server (laisser vide pour désactiver) ---
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Taux fixe de démonstration : combien de FCFA vaut 1 BTC (à régler le jour de la démo)
TAUX_FCFA_PAR_BTC=
# Part du prix payée en Lightning à la réservation (le reste se règle avec le propriétaire)
ACOMPTE_POURCENT=30
